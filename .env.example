# =========================
# Ava AI Companion - Example .env
# =========================

# === Core AI & Model Providers ===
GROQ_API_KEY=""

ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

TOGETHER_API_KEY=""

# === Vector Database ===
QDRANT_URL=""
QDRANT_API_KEY=""

# === Langfuse (optional, for cloud-hosted logging/monitoring) ===
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# === Telegram Bot Configuration ===
# Get your bot token from BotFather: https://t.me/botfather
TELEGRAM_BOT_TOKEN=""
# For local development with ngrok: https://your-ngrok-url.ngrok-free.app/telegram_webhook
# For production: https://your-domain.com/telegram_webhook
TELEGRAM_WEBHOOK_URL=""

# === Reminder System ===
# All reminders and time-based features use Indian Standard Time (IST, Asia/Kolkata).
# No additional configuration needed, but ensure your system time is correct if running locally.

# === Notes ===
# - Fill in all required API keys and tokens.
# - For Telegram, set your webhook using the Telegram API and your public URL.
# - Remove any unused variables as needed for your deployment.
